API_BASE_URL=http://192.168.0.10:3000
DEVICE_API_KEY=replace-with-a-long-random-secret
DEVICE_ID=give-box-01

# true면 GPIO/카메라 없이 키보드로 흐름을 테스트합니다.
MOCK_HARDWARE=false

# BCM GPIO 번호
RELAY_PIN=17
RELAY_ACTIVE_HIGH=false
SENSOR_PIN=27
SENSOR_PULL_UP=true

CAMERA_INDEX=0
ITEM_WAIT_TIMEOUT=60
SENSOR_STABLE_SECONDS=1.0
SCAN_COOLDOWN_SECONDS=2
REQUEST_TIMEOUT_SECONDS=8
VERIFY_TLS=true
SHOW_CAMERA_PREVIEW=false
LOG_LEVEL=INFO
