[Unit]
Description=Give Smart Locker Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hanseungjae
WorkingDirectory=/home/hanseungjae/give-app/smart_locker
EnvironmentFile=/home/hanseungjae/give-app/smart_locker/.env
ExecStart=/home/hanseungjae/give-app/smart_locker/.venv/bin/python /home/hanseungjae/give-app/smart_locker/locker_agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
