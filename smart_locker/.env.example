BACKEND_URL=http://localhost:3001
LOCKER_DEVICE_ID=locker-1
LOCKER_DEVICE_API_KEY=change-me

# BCM GPIO numbers. Keep these equal to your existing breadboard wiring.
RELAY_PIN=18
RED_LED_PIN=23

# Most relay boards are active-low. Change to false if your relay turns on with HIGH.
RELAY_ACTIVE_LOW=true
RED_LED_ACTIVE_HIGH=true

OPEN_PULSE_SECONDS=3
POLL_INTERVAL_SECONDS=1
REQUEST_TIMEOUT_SECONDS=5

# Set true on a laptop to test without Raspberry Pi GPIO.
MOCK_GPIO=false
