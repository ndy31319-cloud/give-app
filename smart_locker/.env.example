# Render backend used by the locker agent. Do not use localhost on Raspberry Pi.
BACKEND_URL=https://give-app.onrender.com
LOCKER_DEVICE_ID=locker-1
LOCKER_DEVICE_API_KEY=replace_with_the_same_value_as_backend_LOCKER_DEVICE_API_KEY

# BCM GPIO numbers
RELAY_PIN=18
RED_LED_PIN=23

# Most relay modules are active-low. Change only if your relay works inversely.
RELAY_ACTIVE_LOW=true
RED_LED_ACTIVE_HIGH=true
OPEN_PULSE_SECONDS=3

# Render polling and request settings
POLL_INTERVAL_SECONDS=1
REQUEST_TIMEOUT_SECONDS=5
