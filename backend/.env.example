NODE_ENV=development
# Comma-separated frontend origins. Example: http://localhost:8082
CORS_ORIGINS=
DB_HOST=your-db-host
DB_PORT=your-db-port
DB_DATABASE=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=24h
ADMIN_DELETE_KEY=your-dev-delete-key
# AI server failover order. The AI server can run separately from Render.
# Local backend development defaults to http://127.0.0.1:8000 when these are empty.
# Render cannot reach your Mac's 127.0.0.1, so use a public tunnel URL there
# such as https://your-ai-tunnel.ngrok-free.app or a Cloudflare Tunnel URL.
AI_SERVER_URL=your-public-ai-server-or-tunnel-url
AI_SERVER_URL_PRIMARY=your-primary-ai-server-url
AI_SERVER_URL_LOCAL=http://127.0.0.1:8000
AI_SERVER_URL_FALLBACK=your-fallback-ai-server-url
AI_CHATBOT_URL=
AI_SERVER_ALLOW_LOOPBACK_IN_PRODUCTION=false
AI_SERVER_DISABLE_LOCAL_DEFAULT=true

# 정부24 공공서비스 정책 API. 정책 DB 동기화 스크립트에서만 사용합니다.
ODCLOUD_BASE_URL=https://api.odcloud.kr/api
ODCLOUD_API_KEY=your-odcloud-service-key
ODCLOUD_SERVICE_LIST_PATH=/gov24/v3/serviceList
ODCLOUD_SERVICE_DETAIL_PATH=/gov24/v3/serviceDetail
ODCLOUD_SUPPORT_CONDITIONS_PATH=/gov24/v3/supportConditions
ODCLOUD_POLICY_SYNC_LIMIT=1000
POLICY_CACHE_TTL_MS=60000
POLICY_CHAT_CONTEXT_LIMIT=40
AI_STREAM_REQUEST_TIMEOUT_MS=60000
ODCLOUD_FETCH_DETAILS=false
# Optional one-off filter for refreshing a specific service name.
# ODCLOUD_SERVICE_NAME_FILTER=에너지바우처

KIOSK_API_KEY=your-kiosk-api-key
DEFAULT_LOCKER_ID=locker-1
LOCKER_DEVICE_API_KEY=your-raspberry-pi-locker-key

# Option 1
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 2
FIREBASE_SERVICE_ACCOUNT_JSON={"projectId":"your-project-id","clientEmail":"your-client-email","privateKey":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
