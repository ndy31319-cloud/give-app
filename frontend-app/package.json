    "android:assemble:java17": "test -x ./android/gradlew || (echo \"android/gradlew not found. Run npm run android:prebuild:java17 first.\" >&2 && exit 1); ./scripts/with-java17.sh ./android/gradlew -p android app:assembleDebug",
