{
  "expo": {
    "name": "Give,기부",
    "slug": "give-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rnapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.givern"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "게시글 사진 등록과 AI 판독을 위해 사진 접근 권한이 필요합니다.",
          "cameraPermission": "게시글 사진 촬영과 AI 판독을 위해 카메라 권한이 필요합니다."
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 지도에 표시하고 약속장소를 정하기 위해 위치 접근 권한이 필요합니다."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45a01393-950a-4a43-b585-8ad698c18f38"
      }
    },
    "owner": "dayeong10"
  }
}
