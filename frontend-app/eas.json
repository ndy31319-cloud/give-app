{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://give-app.onrender.com",
        "EXPO_PUBLIC_USE_MOCK_API": "false"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
